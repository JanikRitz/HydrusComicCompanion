<MudDialog>
    <TitleContent>
        Delete collection
    </TitleContent>
    <DialogContent>
        Delete '@Comic' from local cache? This removes cached images and metadata, not files or tags in Hydrus.
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="Submit">Delete</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string Comic { get; set; } = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();
}
