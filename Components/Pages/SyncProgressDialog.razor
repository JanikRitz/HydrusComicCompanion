@using HydrusComicCompanion.Models

<MudDialog>
    <TitleContent>
        @Title
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body1">
                @DisplayMessage
            </MudText>
            @if (!string.IsNullOrWhiteSpace(Detail))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Detail
                </MudText>
            }
            @if (Total > 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Current / @Total
                </MudText>
                <MudProgressLinear Color="Color.Primary" Value="@ProgressPercent" Rounded="true" />
            }
            else
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Rounded="true" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="@_isStopping" OnClick="RequestCancelAsync">
            @(_isStopping ? "Stopping..." : CancelButtonText)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string Title { get; set; } = "Working";

    [Parameter]
    public int Current { get; set; }

    [Parameter]
    public int Total { get; set; }

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string Detail { get; set; } = string.Empty;

    [Parameter]
    public string CancelButtonText { get; set; } = "Stop";

    [Parameter]
    public Action<Action<LongRunningProgressUpdate>>? RegisterProgressHandler { get; set; }

    [Parameter]
    public Func<Task>? OnCancelRequested { get; set; }

    private bool _isStopping;

    private string DisplayMessage => string.IsNullOrWhiteSpace(Message)
        ? "Working..."
        : Message;

    private double ProgressPercent => Total <= 0
        ? 0d
        : Math.Clamp((double)Current / Total * 100d, 0d, 100d);

    protected override void OnInitialized()
    {
        RegisterProgressHandler?.Invoke(HandleProgress);
    }

    private void HandleProgress(LongRunningProgressUpdate update)
    {
        Current = update.Current;
        Total = update.Total;
        Message = update.Message;
        Detail = update.Detail;

        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RequestCancelAsync()
    {
        if (_isStopping)
        {
            return;
        }

        _isStopping = true;

        if (OnCancelRequested is not null)
        {
            await OnCancelRequested();
        }
    }
}
